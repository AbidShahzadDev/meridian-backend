{
  "info": {
    "_postman_id": "923ef960-3943-4f3d-90be-a1ca3e348c29",
    "name": "Meridian Backend API",
    "description": "Postman collection for the Meridian storefront and role-protected admin API. Seed the super admin, set adminEmail/adminPassword, run Admin Login, then run protected CRUD requests. Login and refresh automatically save JWTs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        { "name": "Root", "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [], "url": "{{baseUrl}}/" }, "response": [] },
        { "name": "API v1", "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [], "url": "{{baseUrl}}/v1" }, "response": [] }
      ]
    },
    {
      "name": "Auth",
      "item": [
        { "name": "Auth Root", "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [], "url": "{{baseUrl}}/v1/auth" }, "response": [] },
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"jane@example.com\",\n  \"phoneNo\": \"+923001234567\",\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"username\": \"jane_doe\",\n  \"profilePicture\": \"https://example.com/jane.jpg\",\n  \"password\": \"Buyer@12345\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/v1/auth/register"
          },
          "response": []
        },
        {
          "name": "Admin Login",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Login succeeded', () => pm.response.to.have.status(200));", "const json = pm.response.json();", "pm.test('Access and refresh tokens returned', () => {", "  pm.expect(json.data?.accessToken).to.be.a('string').and.not.empty;", "  pm.expect(json.data?.refreshToken).to.be.a('string').and.not.empty;", "});", "pm.test('User has dashboard role', () => pm.expect(['admin', 'super_admin']).to.include(json.data?.user?.role));", "if (json.data?.accessToken) pm.collectionVariables.set('accessToken', json.data.accessToken);", "if (json.data?.refreshToken) pm.collectionVariables.set('refreshToken', json.data.refreshToken);", "if (json.data?.user?._id) pm.collectionVariables.set('userId', json.data.user._id);"] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/v1/auth/login"
          },
          "response": []
        },
        { "name": "Current User", "event": [{ "listen": "test", "script": { "exec": ["pm.test('Authenticated user returned', () => pm.response.to.have.status(200));", "const json = pm.response.json();", "pm.test('User has dashboard role', () => pm.expect(['admin', 'super_admin']).to.include(json.data?.role));"] } }], "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/v1/auth/me" }, "response": [] },
        {
          "name": "Refresh Access Token",
          "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "if (json.data?.accessToken) pm.collectionVariables.set('accessToken', json.data.accessToken);", "if (json.data?.refreshToken) pm.collectionVariables.set('refreshToken', json.data.refreshToken);"] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/v1/auth/refresh"
          }, "response": []
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        { "name": "Get Users", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/v1/users" }, "response": [] },
        {
          "name": "Create User",
          "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "const id = json.data?.id || json.user?.id || json.id;", "if (id) pm.collectionVariables.set('userId', id);"] } }],
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"john_doe\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john@example.com\",\n  \"phoneNo\": \"+923009876543\",\n  \"profilePicture\": \"https://example.com/john.jpg\",\n  \"password\": \"Buyer@12345\",\n  \"role\": \"buyer\",\n  \"isActive\": true\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/v1/users"
          }, "response": []
        },
        {
          "name": "Update User", "request": {
            "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Jonathan\",\n  \"phoneNo\": \"+923001112222\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/v1/users/{{userId}}"
          }, "response": []
        },
        { "name": "Delete User", "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/v1/users/{{userId}}" }, "response": [] },
        {
          "name": "Upload My Profile Image",
          "request": {
            "method": "PUT",
            "header": [],
            "body": { "mode": "formdata", "formdata": [{ "key": "profileImage", "type": "file", "src": [] }] },
            "url": "{{baseUrl}}/v1/users/me/profile-image",
            "description": "Authenticated users can upload their own JPEG, PNG, WebP, or GIF profile image (maximum 5 MB). Select a local file for profileImage."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Brands",
      "item": [
        { "name": "Get Brands", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/v1/brands" }, "response": [] },
        {
          "name": "Create Brand",
          "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "const id = json.data?.id || json.id;", "if (id) pm.collectionVariables.set('brandId', id);"] } }],
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Acme\",\n  \"logo\": \"https://example.com/acme.png\",\n  \"status\": \"active\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/v1/brands"
          }, "response": []
        },
        { "name": "Get Brand", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/v1/brands/{{brandId}}" }, "response": [] },
        {
          "name": "Update Brand", "request": {
            "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Acme Updated\",\n  \"status\": \"active\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/v1/brands/{{brandId}}"
          }, "response": []
        },
        { "name": "Delete Brand", "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/v1/brands/{{brandId}}" }, "response": [] }
      ]
    },
    {
      "name": "Categories",
      "item": [
        { "name": "Get Categories", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/v1/categories" }, "response": [] },
        {
          "name": "Create Category",
          "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "const id = json.data?.id || json.id;", "if (id) pm.collectionVariables.set('categoryId', id);"] } }],
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Electronics\",\n  \"image\": \"https://example.com/electronics.jpg\",\n  \"description\": \"Electronic products and accessories\",\n  \"status\": \"active\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/v1/categories"
          }, "response": []
        },
        { "name": "Get Category", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/v1/categories/{{categoryId}}" }, "response": [] },
        {
          "name": "Update Category", "request": {
            "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Consumer Electronics\",\n  \"description\": \"Updated category description\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/v1/categories/{{categoryId}}"
          }, "response": []
        },
        { "name": "Delete Category", "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/v1/categories/{{categoryId}}" }, "response": [] }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Get Products",
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}/v1/products?page=1&limit=20&search=&categoryId=&brandId=&status=active&isFeatured=&minPrice=&maxPrice=&sort=createdAt&order=desc", "host": ["{{baseUrl}}"], "path": ["v1", "products"], "query": [
              { "key": "page", "value": "1" }, { "key": "limit", "value": "20" }, { "key": "search", "value": "", "disabled": true },
              { "key": "categoryId", "value": "{{categoryId}}", "disabled": true }, { "key": "brandId", "value": "{{brandId}}", "disabled": true },
              { "key": "status", "value": "active" }, { "key": "isFeatured", "value": "true", "disabled": true },
              { "key": "minPrice", "value": "10", "disabled": true }, { "key": "maxPrice", "value": "1000", "disabled": true },
              { "key": "sort", "value": "createdAt" }, { "key": "order", "value": "desc" }
            ] }
          }, "response": []
        },
        {
          "name": "Create Product",
          "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "const id = json.data?.id || json.id;", "if (id) pm.collectionVariables.set('productId', id);"] } }],
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Wireless Headphones\",\n  \"description\": \"Comfortable wireless headphones\",\n  \"shortDescription\": \"Bluetooth headphones\",\n  \"sku\": \"WH-001\",\n  \"barcode\": \"1234567890123\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"brandId\": \"{{brandId}}\",\n  \"price\": 99.99,\n  \"salePrice\": 79.99,\n  \"stock\": 50,\n  \"weight\": 0.3,\n  \"dimensions\": \"20x18x8 cm\",\n  \"featuredImage\": \"https://example.com/headphones.jpg\",\n  \"gallery\": [\"https://example.com/headphones-2.jpg\"],\n  \"status\": \"active\",\n  \"isFeatured\": true\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/v1/products"
          }, "response": []
        },
        { "name": "Get Product", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/v1/products/{{productId}}" }, "response": [] },
        {
          "name": "Upload Product Images",
          "request": {
            "method": "PUT",
            "header": [],
            "body": { "mode": "formdata", "formdata": [
              { "key": "featuredImage", "type": "file", "src": [] },
              { "key": "gallery", "type": "file", "src": [] },
              { "key": "replaceGallery", "value": "false", "type": "text" }
            ] },
            "url": "{{baseUrl}}/v1/products/{{productId}}/images",
            "description": "Admin-only multipart upload. featuredImage accepts one file; gallery accepts up to eight files with the same field name. Set replaceGallery=true to replace the existing gallery. Maximum 5 MB per image."
          },
          "response": []
        },
        {
          "name": "Update Product", "request": {
            "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Wireless Headphones Pro\",\n  \"price\": 109.99,\n  \"stock\": 40,\n  \"isFeatured\": true\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/v1/products/{{productId}}"
          }, "response": []
        },
        { "name": "Delete Product", "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/v1/products/{{productId}}" }, "response": [] }
      ]
    }
  ],
