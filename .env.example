PORT=6543

# Source database, needed only while running the Mongo-to-Supabase migration.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/backend_test
MONGODB_DATABASE=backend_test

# Supabase PostgreSQL pooled connection used by the running API.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true

# Supabase direct/session connection used for schema migrations.
DIRECT_URL=postgresql://USER:PASSWORD@SESSION_POOLER_HOST:5432/postgres

# Supabase Auth email OTP provider. Use the project's public/publishable key.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-key
AUTH_EMAIL_PROVIDER=supabase

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_REFRESH_EXPIRY=7d

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Email verification through Amazon SES.
SENDER_EMAIL=firebase-adminsdk-fbsvc@meridian-cddac.iam.gserviceaccount.com
SENDER_NAME=Einfalt
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_DEFAULT_REGION=us-east-1

AWS_ACCESS_KEY_ID=replace-with-aws-access-key
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=replace-with-bucket-name
S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
# Optional CloudFront or custom public base URL, without a trailing slash.
S3_PUBLIC_BASE_URL=https://cdn.example.com

WEBAPP_URL=http://localhost:3000
TEMP_WEBAPP_URL=http://localhost:3000
PROD_WEBAPP_URL=https://example.com

# Cash on delivery checkout settings.
STORE_CURRENCY=PKR
COD_SHIPPING_FEE=0

# Firebase Admin credentials for server-side FCM delivery.
# Keep the private key out of source control. Alternatively configure
# GOOGLE_APPLICATION_CREDENTIALS to point to a service-account JSON file.
FIREBASE_PROJECT_ID=meridian-cddac
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@meridian-cddac.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=REDACTED

# Server-only Gemini credentials. Never prefix these with NEXT_PUBLIC_ or expose them to a browser.
# GEMINI_API_KEY=REDACTED
# GEMINI_MODEL=gemini-3.5-flash
