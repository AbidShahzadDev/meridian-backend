{
  "name": "Meridian",
  "version": "1.0.0",
  "description": "Node + Typescript API for Meridian App",
  "main": "index.ts",
  "scripts": {
    "dev": "nodemon --watch src -e ts,tsx --exec ts-node --files src/index.ts",
    "build": "tsc",
    "test:chat-security": "npm run build && node tests/chat-security.smoke.js",
    "test:order-security": "npm run build && node tests/order-security.smoke.js",
    "test:auth-verification": "npm run build && node tests/auth-verification.smoke.js",
    "start": "node dist/index.js",
    "seed:admin": "ts-node --files src/scripts/seedAdmin.ts",
    "seed:products": "ts-node --files src/scripts/seedProducts.ts",
    "repair:product-images": "ts-node --files src/scripts/repairSeedProductImages.ts",
    "migrate:mongo-to-supabase": "ts-node --files src/scripts/migrateMongoToSupabase.ts",
    "typeorm": "typeorm-ts-node-commonjs",
    "schema:sync": "npx typeorm-ts-node-commonjs schema:sync",
    "typeorm:cache": "npx typeorm-ts-node-commonjs cache:clear",
    "schema:drop": "npx typeorm-ts-node-commonjs -d ./src/data-source.ts",
    "migration:create": "typeorm migration:create ./src/migrations/",
    "migration:generate": "npm run typeorm migration:generate -- -d src/data-source.ts ./src/migrations/users-schema-changes",
    "migration:show": "npx typeorm-ts-node-commonjs migration:show -d ./src/data-source.ts",
    "migration:run": "npx typeorm-ts-node-commonjs migration:run -d  ./src/data-source.ts",
    "migration:revert": "npx typeorm-ts-node-commonjs migration:revert -d ./src/data-source.ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.499.0",
    "@aws-sdk/client-ses": "^3.499.0",
    "@aws-sdk/cloudfront-signer": "^3.535.0",
    "@aws-sdk/s3-request-presigner": "^3.503.0",
    "@google/genai": "^2.12.0",
    "@prisma/client": "^5.18.0",
    "@supabase/supabase-js": "^2.110.6",
    "@types/multer": "^1.4.12",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "date-fns": "^3.3.1",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "firebase-admin": "^14.1.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.7.4",
    "multer": "^2.0.2",
    "nodemon": "^3.0.3",
    "pg": "^8.11.3",
    "prisma": "^5.18.0",
    "reflect-metadata": "^0.2.1",
    "stripe": "^14.19.0",
    "typeorm": "^0.3.19",
    "uuid": "^9.0.0",
    "zod": "^3.22.4",
    "zod-validation-error": "^3.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.6",
    "@types/pg": "^8.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
