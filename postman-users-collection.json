      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"telegramId\": \"123456789\",\n  \"username\": \"jane_doe\",\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"email\": \"jane@example.com\",\n  \"phoneNo\": \"+923001234567\",\n  \"profilePicture\": \"https://example.com/jane.jpg\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/v1/users",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "users"]
        },
        "description": "Validates and creates a user in MongoDB. Email, Telegram ID, and phone number must be unique."
